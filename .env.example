# 使用任意 OpenAI Chat Completions 兼容模型时填写；未配置时服务会使用可测试的规则化回答。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# 全项目唯一数据源：运行服务前先执行 `uv run alembic upgrade head`。
# 请仅在本机 .env 或部署平台的 Secret Manager 写入真实口令。
DATABASE_URL=postgresql+psycopg://skin_assistant:change_me@127.0.0.1:5432/skin_assistant
# Docker 内运行后端时使用；postgres 是 Compose 网络内的数据库服务名。
# 与 POSTGRES_PASSWORD 保持相同口令，且口令须进行 URL 编码。
DATABASE_URL_DOCKER=postgresql+psycopg://skin_assistant:change_me@postgres:5432/skin_assistant
POSTGRES_DB=skin_assistant
POSTGRES_USER=skin_assistant
POSTGRES_PASSWORD=
# Docker 默认映射到宿主机 5433；若 5432 空闲且需要改回，可显式设置 POSTGRES_PORT=5432。
# POSTGRES_PORT=5433
# APP_PORT=8000
APP_ENV=development
CONFIRMATION_TOKEN_TTL_SECONDS=900

# OA/RBAC：生产必须由 Secret Manager 注入高熵 OA_JWT_SECRET，并在 HTTPS 下设置 Cookie Secure。
OA_JWT_SECRET=
OA_CORS_ORIGINS=http://localhost:5173,http://localhost:8848
OA_COOKIE_SECURE=false
# 首次迁移后一次性创建管理员，执行完成后请从环境变量/Secret 中移除该口令。
# OA_BOOTSTRAP_USERNAME=admin
# OA_BOOTSTRAP_PASSWORD=

# 前台用户与 OA 员工体系分表、分令牌。生产环境必须单独设置 CUSTOMER_JWT_SECRET。
# CUSTOMER_JWT_SECRET=
# 当前阶段仅记录邮箱和找回请求，不实际投递。接入并验收 SMTP 后才改为 true。
CUSTOMER_EMAIL_DELIVERY_ENABLED=false
# 生产环境必须使用 smtp。file 将邮件写到仅本机可见的 outbox；log 不记录正文或 token。
CUSTOMER_MAIL_MODE=log
CUSTOMER_APP_BASE_URL=http://localhost:5179
CUSTOMER_COOKIE_SECURE=false
# 前台持久登录的 HttpOnly refresh 会话固定为 7 天；access token 仍为 15 分钟。
# CUSTOMER_MAIL_OUTBOX_DIR=/private/tmp/skin-assistant-mail-outbox
# CUSTOMER_MAIL_FROM=no-reply@example.com
# CUSTOMER_MAIL_HOST=smtp.example.com
# CUSTOMER_MAIL_PORT=465
# CUSTOMER_MAIL_USERNAME=
# CUSTOMER_MAIL_PASSWORD=
# CUSTOMER_MAIL_USE_TLS=true
# CUSTOMER_BOOTSTRAP_USERNAME=customer
# CUSTOMER_BOOTSTRAP_PASSWORD=
# CUSTOMER_BOOTSTRAP_DISPLAY_NAME=澄肌用户

# 模型调用和图执行防护。默认每次运行最多一次模型调用、单次模型请求 8 秒且 SDK 不重试；
# 超时或预算耗尽时返回基于审核证据的确定性兜底，不再消耗 Token。
MODEL_MAX_CALLS_PER_RUN=1
MODEL_REQUEST_TIMEOUT_SECONDS=8
EMBEDDING_REQUEST_TIMEOUT_SECONDS=6
LANGGRAPH_RECURSION_LIMIT=24
AGENT_RUN_TIMEOUT_SECONDS=12

# 商城读模型。默认 mock；切换 mall 后必须同时提供 OAuth2 测试环境配置，缺失时服务启动失败，
# 不会回退为 Mock。访问令牌由 client credentials 临时获取，所有密钥仅保存在忽略的 .env/Secret Manager。
CATALOG_SOURCE=mock
# 本地商品后台已完成迁移、并需要让公开目录/Agent 从其读取时，设为 database。
# 该模式不会回退到 Mock；商品必须同时 assistant_approved=true 与 on_sale=true 才能被 Agent 读取。
# CATALOG_SOURCE=database
# 商品图片默认保存在 data/runtime/uploads/products；生产需挂载持久卷或改为对象存储适配器。
# PRODUCT_UPLOAD_DIR=/var/lib/skin-assistant/uploads/products
# MALL_CATALOG_BASE_URL=https://mall-api.test
# MALL_CATALOG_TIMEOUT_SECONDS=2
# MALL_OAUTH_TOKEN_URL=https://identity.test/oauth/token
# MALL_OAUTH_CLIENT_ID=skin-assistant-backend
# MALL_OAUTH_CLIENT_SECRET=
# MALL_OAUTH_SCOPE=catalog.assistant.read inventory.assistant.read

# RAG 默认仅用本地词法检索；启用 SiliconFlow BGE-M3 时取消注释并仅在 .env 保存密钥。
RAG_EMBEDDER=lexical
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# EvalOps 默认不调用外部模型。开启后，LLM 才可生成候选评测题与回答质量复核；
# 安全、证据和交易硬门始终由本地确定性规则决定。
EVAL_LLM_ENABLED=false
# EVAL_OPENAI_API_KEY=
# EVAL_OPENAI_BASE_URL=https://api.deepseek.com
# EVAL_OPENAI_MODEL=deepseek-chat

# 可选线上观测。默认关闭；即使开启也只上传问题哈希、长度与结构化执行摘要，
# 不上传用户问题、回答正文、身份信息或模型思维链。使用时通过 Secret Manager 注入密钥。
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
